//template
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │          │          │          │          │          │
        // &trans     &trans     &trans     &trans     &trans         &trans     &trans     &trans     &trans      &trans
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │          │          │          │          │
        // &trans     &trans     &trans     &trans     &trans         &trans     &trans     &trans     &trans     &trans
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │          │          │          │          │
        // &trans     &trans     &trans     &trans     &trans         &trans     &trans     &trans     &trans     &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
        //                                   &trans     &trans         &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/modifiers.h>

#define HRML(k1,k2,k3,k4) &ht LALT k1  &ht LSHFT k2  &ht LCTRL k3  &ht LGUI k4
#define HRMR(k1,k2,k3,k4) &ht RGUI k1  &ht RCTRL k2  &ht RSHFT k3  &ht RALT k4

#define DEF   0
#define RIG   1
#define LEF   2
#define TRI   3
#define GAME  4
#define GAME2  5
#define FR    6
#define RU    7

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        // Cyrillic has 33 letters but the layer only has 30 physical keys.
        // ё and ъ are dropped (casual Russian typing already substitutes е / omits ъ);
        // х and э piggyback on к and е via shift, since their own rows were full.
        morph_k_kh: morph_k_kh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc_ru_k>, <&uc_ru_kh>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        morph_e_eob: morph_e_eob {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc_ru_e>, <&uc_ru_eob>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_fr {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&tog FR>;
            layers = <0>;
        };
        combo_ru {
            timeout-ms = <50>;
            key-positions = <5 6>;
            bindings = <&tog RU>;
            layers = <0>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
// ==== FRENCH MACROS ====
        uc_eacute: uc_eacute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp E &kp N9>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp SPACE>
                ;
        }; // é U+00E9
        uc_egrave: uc_egrave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp E &kp N8>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp SPACE>
                ;
        }; // è U+00E8
        uc_ecirc: uc_ecirc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp E &kp A>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp SPACE>
                ;
        }; // ê U+00EA
        uc_ediaer: uc_ediaer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp E &kp B>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp SPACE>
                ;
        }; // ë U+00EB
        uc_agrave: uc_agrave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp E &kp N0>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp SPACE>
                ;
        }; // à U+00E0
        uc_acirc: uc_acirc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp E &kp N2>
                , <&macro_release &kp LCTRL &kp LSHFT>
