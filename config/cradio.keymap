            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N4 &kp N4 &kp N0>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp SPACE>
                ;
        }; // р U+0440
        uc_ru_s: uc_ru_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N4 &kp N4 &kp N1>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp SPACE>
                ;
        }; // с U+0441
        uc_ru_t: uc_ru_t {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N4 &kp N4 &kp N2>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp SPACE>
                ;
        }; // т U+0442
        uc_ru_u: uc_ru_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N4 &kp N4 &kp N3>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp SPACE>
                ;
        }; // у U+0443
