                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N4 &kp N4 &kp N7>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp SPACE>
                ;
        }; // ч U+0447
        uc_ru_sh: uc_ru_sh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
