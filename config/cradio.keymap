                , <&macro_tap &kp SPACE>
                ;
        }; // œ U+0153
        uc_eacuteup: uc_eacuteup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U &kp N0 &kp N0 &kp C &kp N9>
